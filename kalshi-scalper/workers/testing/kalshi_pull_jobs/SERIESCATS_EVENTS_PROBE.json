{
 "job_id": "SERIESCATS_EVENTS_PROBE",
 "registration": "kalshi-scalper/workers/testing/SERIESCATS_EVENTS_REGISTRATION.md",
 "purpose": "Probe: events list of 3 series with and without status, to see whether the default returns settled events. Metadata only.",
 "heldout": "none (event metadata only: event ticker, series, category, strike or close date; no market, no price, no result)",
 "allowed_endpoints": [
  {
   "name": "events_list",
   "method": "GET",
   "path_pattern": "/events",
   "params_allowed": [
    "series_ticker",
    "status",
    "limit",
    "cursor"
   ]
  }
 ],
 "series_allowlist": [
  "AAPLCEOCHANGE",
  "KX60MINMENTION",
  "KXTOKENUSED"
 ],
 "ticker_allowlist": [],
 "max_requests": 6,
 "requests": [
  {
   "id": "p_all_KXTOKENUSED",
   "path": "/events",
   "params": {
    "series_ticker": "KXTOKENUSED",
    "limit": 200
   },
   "max_pages": 1
  },
  {
   "id": "p_settled_KXTOKENUSED",
   "path": "/events",
   "params": {
    "series_ticker": "KXTOKENUSED",
    "status": "settled",
    "limit": 200
   },
   "max_pages": 1
  },
  {
   "id": "p_all_KX60MINMENTION",
   "path": "/events",
   "params": {
    "series_ticker": "KX60MINMENTION",
    "limit": 200
   },
   "max_pages": 1
  },
  {
   "id": "p_settled_KX60MINMENTION",
   "path": "/events",
   "params": {
    "series_ticker": "KX60MINMENTION",
    "status": "settled",
    "limit": 200
   },
   "max_pages": 1
  },
  {
   "id": "p_all_AAPLCEOCHANGE",
   "path": "/events",
   "params": {
    "series_ticker": "AAPLCEOCHANGE",
    "limit": 200
   },
   "max_pages": 1
  },
  {
   "id": "p_settled_AAPLCEOCHANGE",
   "path": "/events",
   "params": {
    "series_ticker": "AAPLCEOCHANGE",
    "status": "settled",
    "limit": 200
   },
   "max_pages": 1
  }
 ],
 "notes": "6 requests, 1 page each; nothing is read before the registration's reader step.",
 "owner": "MAIN",
 "host": "api.elections.kalshi.com",
 "base_path": "/trade-api/v2",
 "pacing_seconds": 1.0,
 "status": "active",
 "stop_rules": {
  "pause_seconds_on_429": "5, doubling to 60",
  "stop_after_consecutive_429": 3,
  "note": "a 429 is waited out with a doubling pause and the same request is asked again; three in a row end the run; no other address, no proxy, no retry around a refusal"
 }
}
