{
 "job_id": "ECONCENSUS_LISTS",
 "owner": "DESK_B",
 "status": "active",
 "registration": "kalshi-scalper/workers/econcensus/ECONCENSUS_NOTE.md",
 "purpose": "Census: settled markets of US macro release series and four hourly temperature series before a fixed cut, plus one Economics series list, to count markets and release dates per series. No candle, no test.",
 "heldout": "FIXED date constant: closes at or after 2026-10-17T00:00:00Z are never requested (every markets request carries max_close_ts = 1792195199, one second before). The held-out window is therefore not read by this job; a later test of these families reads only from 2026-10-17T00:00:00Z on, under its own registration.",
 "allowed_endpoints": [
  {
   "name": "series_list",
   "method": "GET",
   "path_pattern": "/series",
   "params_allowed": [
    "limit",
    "category"
   ]
  },
  {
   "name": "markets_list",
   "method": "GET",
   "path_pattern": "/markets",
   "params_allowed": [
    "series_ticker",
    "status",
    "min_close_ts",
    "max_close_ts",
    "limit",
    "cursor"
   ]
  }
 ],
