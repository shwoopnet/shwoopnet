{
 "job_id": "ECONLAG_CALENDAR",
 "owner": "DESK_B",
 "registration": "kalshi-scalper/workers/IDEA_DESK_B_PROTOCOLS.md",
 "purpose": "ECONLAG stage 1 (slow-family paper screen, try 1): settled market lists of the three release series and the Fed decision series, to verify the count of print days (about 70 expected) before any candle is asked for. No candle is read.",
 "heldout": "none at this stage (lists only; the screen's pinned cutoff is 2026-10-31, in ECONLAG amendment 2)",
 "allowed_endpoints": [
  {
   "name": "markets_list",
   "method": "GET",
   "path_pattern": "/markets",
   "params_allowed": [
    "series_ticker",
    "status",
    "limit",
    "cursor"
   ]
  },
  {
   "name": "hist_markets_list",
   "method": "GET",
   "path_pattern": "/historical/markets",
   "params_allowed": [
    "series_ticker",
    "limit",
    "cursor"
   ]
  },
  {
   "name": "series",
   "method": "GET",
   "path_pattern": "/series/(?P<series>[A-Z0-9]{2,32})",
   "params_allowed": []
  }
 ],
