rules_version = '2';

// Single-owner model. Every user document lives at users/{uid}, one per
// account, holding the account's synced preferences and the flags the page
// reads (isAdmin, kalshiJournal). Old fields from the removed trading pages
// (journalEntries, alpacaKeyId and the rest) may still sit on a document;
// nothing in the page reads or writes them, and shwoop-server's Admin SDK
// is what still does. There are no subcollections under users/{uid}.
//
// A signed-in account may only touch its own document, there is an admin
// flag, and NO ACCOUNT CAN BE CREATED FROM A BROWSER: the invite-code system
// that used to gate creation was removed with the sign-up form (Oct 12,
// 2026, the blank slate), and a create is refused outright. An account's
// document is made by hand in the Firebase console, or by the Admin SDK.
//
// shwoop-server's backend uses the Admin SDK, which bypasses these
// rules entirely -- this only ever constrains requests from a browser
// using the client SDK. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // isAdmin is a plain field on the user's own document rather than a
    // custom claim, specifically so promoting the one admin account
    // needs no backend script or service-account access -- it's set
    // once, by hand, in the Firebase console (a trusted, rules-bypassing
    // path, same as the Admin SDK). The update rule below makes sure a
    // signed-in user can never flip this field on themselves from the
    // client SDK.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Only the admin account can ever hold live Alpaca credentials. The page
    // no longer has any control for it, but shwoop-server reads these fields
    // from the user document and relies on this file for that guarantee (its
    // settings.js does no admin check of its own), so it stays: a non-admin
    // write can never result in a 'live' environment or a non-empty live
    // credential, no matter how it's sent.
    function wouldEnableLiveTrading(data) {
      return data.get('alpacaEnvironment', 'paper') == 'live'
        || data.get('alpacaLiveKeyId', '') != ''
        || data.get('alpacaLiveSecretKey', '') != '';
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // No browser creates an account document. This used to require
      // redeeming a real invite code in the same transaction; the sign-up
      // form and the invite generator are gone, so the door is shut here too
      // rather than left for anyone holding an old unused code and the SDK.
      // (The wouldEnableLiveTrading check that used to sit on create is moot
      // with creation refused; it still guards update below.)
      allow create: if false;

      // isAdmin is otherwise immutable from the client, and a non-admin
      // account can never write itself into live trading -- every other
      // field on your own document is yours to read and write freely,
      // matching how the app has always treated per-user data.
      //
      // kalshiJournal is the admin's Kalshi trade log. It is readable like the
      // rest of the owner's own document, but only an admin may change it.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin == resource.data.isAdmin
        && (isAdmin() || !wouldEnableLiveTrading(request.resource.data))
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kalshiJournal']));
    }

    // The invites collection has no rule: nothing in a browser can read,
    // create or redeem a code any more. Delete the old documents in the
    // console whenever you like; the Admin SDK can still see them.

    // General market data (index levels, headlines, earnings calendar)
    // computed ONCE by shwoop-server on its own schedule and shared by
    // every signed-in account -- there is exactly one document here,
    // regardless of how many accounts exist, so this never scales with
    // the number of users the way each account independently calling
    // Finnhub itself used to. Never client-writable: only the Admin SDK
    // (which bypasses these rules) writes it.
    match /shared/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The halt switch the live scan reads (kalshiBotMeta/control; the path predates the paper bot's removal and is
    // kept so the saved setting survives). Only the admin may write it, only a boolean, only the two fields the page sends.
    match /kalshiBotMeta/control {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['halt', 'at'])
        && request.resource.data.halt is bool;
    }

    // The LIVE test order's records (real money). Written only by the server, readable only by the admin.
    match /kalshiLiveOrders/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The armed live test's control documents (arm switch and the last scan result). The arm switch is flipped by
    // the kalshiLiveArm function, never by the page directly: the server sets its own expiry.
    match /kalshiLiveControl/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // What the live bot did (armed, disarmed, scan ended), shown on the Bot tab. Written only by the server.
    match /kalshiLiveEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The order-book recorder's minute documents and heartbeat. Written only by the scheduled function.
    match /kalshiBookSnaps/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /kalshiBookMeta/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The opening window test's PAPER records and its heartbeat (kalshiOpeningLib.js). Written only by a scheduled function that holds no secrets and cannot place an order.
    match /kalshiOpeningOrders/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /kalshiOpeningControl/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else is denied by default -- Firestore rules deny any
    // request that doesn't match an explicit allow rule, so no further
    // catch-all is needed, but this comment documents that this is
    // intentional, not an oversight.
  }
}
