# unlazy writes its ledgers, dispatch state and hook state into the working
# tree. They are per-session scratch, not project artifacts, and the hook
# state embeds machine-specific absolute paths.
.unlazy/
.unlazy-hook-state.json
.claude/settings.local.json

# unlazy's solo gate ledger is per-task scratch -- the evidence it
# produces belongs in the commit and PR that cite it, not in the tree.
GATES.md
